modules = ["nodejs-24", "python-3.11", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "e2e-lightbox"

[[workflows.workflow]]
name = "e2e-lightbox"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npx playwright test e2e/lightbox.spec.ts --reporter=list"

[workflows.workflow.metadata]
isValidation = true

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[[ports]]
localPort = 8080
externalPort = 8080

[[ports]]
localPort = 8081
externalPort = 80

[[ports]]
localPort = 8082
externalPort = 3002

[[ports]]
localPort = 8083
externalPort = 3001

[[ports]]
localPort = 18338
externalPort = 3000

[nix]
channel = "stable-25_05"

[userenv]

[userenv.shared]
SMTP_HOST = "smtp.hostinger.com"
SMTP_PORT = "465"
VAPID_PUBLIC_KEY = "BLBe7LuDG7MtopGPL_Z_a5_ea8rOnpl4kHXnUObuUZ06S1dWSFDt8ykm4HbxI5mTSDGQgJd_9jF5OXa38K4g3ZY"
VAPID_SUBJECT = "mailto:admin@udupicivicwatch.com"
